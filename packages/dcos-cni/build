#!/bin/bash

set -o errexit -o nounset -o pipefail
go_arch=$(go env GOARCH)

# install glide
curl -fL -O https://github.com/Masterminds/glide/releases/download/v0.13.0/glide-v0.13.0-linux-${go_arch}.tar.gz && \
  tar xzvf glide-v0.13.0-linux-${go_arch}.tar.gz && \
  mv linux-${go_arch}/glide /usr/bin


# Build and install DC/OS CNI plugins.
pushd /pkg/src/dcos-cni/
make
popd

cp /pkg/src/dcos-cni/bin/* $PKG_PATH
